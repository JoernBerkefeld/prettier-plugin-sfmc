{
    "compilerOptions": {
        "allowJs": false,
        "exactOptionalPropertyTypes": true,
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "noEmit": true,
        "noUncheckedIndexedAccess": true,
        "skipLibCheck": false,
        "strict": true,
        "target": "ES2022"
    },
    "include": ["src/index.d.ts", "tests/types/**/*.ts"]
}
